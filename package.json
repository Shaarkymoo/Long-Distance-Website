{
  "name": "couple-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cd server && npm run dev",
    "build": "cd client && npm run build",
    "start": "cd server && npm start",
    "install:all": "cd server && npm install && cd ../client && npm install",
    "deploy": "gcloud run deploy couple-website --source . --region us-central1 --allow-unauthenticated",
    "test": "vitest run",
    "test:watch": "vitest",
    "graphify": "graphify",
    "graphify:update": "graphify --update"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.4",
    "vitest": "^4.1.9"
  }
}
